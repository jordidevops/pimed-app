# =============================================================================
# Variables de entorno — tenant-portal
# =============================================================================
# Entorno DEV  → copia a .env.development  (commiteable, solo localhost)
# Entorno STAGING → copia a .env.staging   (gitignored, valores reales)
# Entorno PROD    → copia a .env.production (gitignored, valores reales)
#
# Obtener la publishable key en dev: supabase status
# Obtener en staging/prod: Supabase Dashboard > Settings > API
# =============================================================================

# URL del proyecto Supabase
# dev:     http://localhost:54321
# staging: https://<staging-ref>.supabase.co
# prod:    https://<prod-ref>.supabase.co
VITE_SUPABASE_URL=http://localhost:54321

# Clave anon pública (segura para el cliente)
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key-here

# Email de suport per CTAs de contacte al portal
VITE_SUPPORT_EMAIL=support@your-company.com

# Branding global (nom de l'app)
VITE_APP_DISPLAY_NAME=Your App

# DNS per a dominis propis del portal públic
# Ha de coincidir amb els valors del public-portal i del worker de verificació
VITE_PORTAL_DNS_CNAME_TARGET=proxy.public.example.com
VITE_PORTAL_DNS_TXT_PREFIX=_portal-verify

# URL base del public-portal per enllaços /e/{secret} (dev local)
VITE_PUBLIC_PORTAL_BASE_URL=http://localhost:3002
# Domini sistema per URLs tipus {slug}.public.{domain} (staging/prod)
# VITE_PUBLIC_PORTAL_SYSTEM_DOMAIN=public.example.dev

# URL base del customer-portal (butlletins /s/{secret} i staff /staff/{secret})
VITE_CUSTOMER_PORTAL_ORIGIN=http://localhost:3003

# Secret compartit per revalidació ISR després de publicar contingut (TCMS-3)
# Ha de coincidir amb REVALIDATE_PORTAL_SECRET al public-portal
# VITE_PORTAL_REVALIDATE_SECRET=dev-revalidate-secret
# Veure docs/runbooks/fase-0-manual-setup.md
VITE_SENTRY_DSN=
VITE_APP_ENVIRONMENT=local
