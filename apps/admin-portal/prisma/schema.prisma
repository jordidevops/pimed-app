/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tenants {
  id                       String                    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  name                     String
  slug                     String                    @unique
  plan_id                  String?                   @db.Uuid
  metadata                 Json?
  is_active                Boolean                   @default(true)
  storage_blocked          Boolean                   @default(false)
  storage_blocked_reason   String?
  storage_blocked_at       DateTime?                 @db.Timestamptz(6)
  public_portal_enabled    Boolean                   @default(false)
  employee_portal_enabled  Boolean                   @default(false)
  tenant_portal_overrides  Json                      @default("{}")
  tenant_portal_entitlements Json                    @default("{}") @map("tenant_portal_entitlements")
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                  @default(now()) @db.Timestamptz(6)
  audit_logs               audit_logs[]
  files                    files[]
  notes                    notes[]
  storage_usage            storage_usage?
  subscriptions            subscriptions[]
  tenant_members           tenant_members[]
  storage_providers        storage_providers[]
  storage_egress_logs      storage_egress_logs[]
  tenant_feature_overrides tenant_feature_overrides[]
  tenant_storage_limits    tenant_storage_limits?
  public_sites             public_sites[]
  plans                    plans?                    @relation(fields: [plan_id], references: [id], onUpdate: NoAction)

  @@schema("data")
}

/// BYOS storage provider configuration per tenant
model storage_providers {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String    @db.Uuid
  provider_type        String    @default("supabase")
  nickname             String?
  endpoint_url         String?
  bucket_name          String?
  region               String?
  is_verified          Boolean   @default(false)
  is_active            Boolean   @default(true)
  is_locked            Boolean   @default(false)
  allowed_mime_types   String[]  @default([])
  max_file_size_bytes  BigInt?
  quota_limit_bytes    BigInt?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  tenants              tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  storage_egress_logs  storage_egress_logs[]

  @@map("storage_providers")
  @@schema("data")
}

/// Platform egress events (downloads via signed URL or share-link resolves)
model storage_egress_logs {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String             @db.Uuid
  node_id             String?            @db.Uuid
  storage_provider_id String?            @db.Uuid
  size_bytes          BigInt             @default(0)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  tenants             tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  storage_providers   storage_providers? @relation(fields: [storage_provider_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("storage_egress_logs")
  @@schema("data")
}

/// Global feature flags with hash-based percentage rollout
model feature_flags {
  key                String                   @id
  description        String?
  is_enabled         Boolean                  @default(true)
  rollout_percentage Int                      @default(100) @db.SmallInt
  created_at         DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                 @default(now()) @db.Timestamptz(6)
  overrides          tenant_feature_overrides[]

  @@map("feature_flags")
  @@schema("data")
}

/// Per-tenant overrides for feature flags (takes precedence over global setting)
model tenant_feature_overrides {
  tenant_id       String        @db.Uuid
  feature_key     String
  override_status Boolean
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  tenants         tenants       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  feature_flags   feature_flags @relation(fields: [feature_key], references: [key], onDelete: Cascade)

  @@id([tenant_id, feature_key])
  @@map("tenant_feature_overrides")
  @@schema("data")
}

/// Admin-controlled limits for the internal (Supabase) storage bucket per tenant
model tenant_storage_limits {
  tenant_id              String    @id @db.Uuid
  internal_quota_gb      Decimal?  @db.Decimal(10, 2)
  internal_max_file_mb   Int?
  internal_allowed_mimes String[]  @default([])
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)
  tenants                tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("tenant_storage_limits")
  @@schema("data")
}

/// Vista d'agregació per tenant per al mòdul de Monetització del Admin Portal.
/// Read-only. Accessible via prisma_admin (BYPASSRLS).
view billing_summary {
  tenant_id                   String   @unique @db.Uuid
  tenant_name                 String
  slug                        String
  is_active                   Boolean
  tenant_created_at           DateTime @db.Timestamptz(6)
  plan_id                     String?  @db.Uuid
  plan_name                   String?
  plan_display_name           String?
  price_monthly               Decimal? @db.Decimal(10, 2)
  max_members                 Int?
  max_storage_mb              Int?
  storage_committed_bytes     BigInt
  storage_reserved_bytes      BigInt
  storage_used_bytes          BigInt
  file_count                  Int
  active_members              Int
  has_active_owner            Boolean
  egress_bytes_current_month  BigInt

  @@schema("data")
}

model public_sites {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String         @db.Uuid
  site_id          String?        @db.Uuid
  slug             String
  name             String
  status           String         @default("draft")
  seo_title        String?
  seo_description  String?
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)
  tenants          tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  public_pages     public_pages[]
  public_domains   public_domains[]
  public_leads     public_leads[]

  @@map("public_sites")
  @@schema("data")
}

model public_pages {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_site_id String       @db.Uuid
  tenant_id      String       @db.Uuid
  slug           String
  title          String
  status         String       @default("draft")
  sort_order     Int          @default(0)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  public_sites   public_sites @relation(fields: [public_site_id], references: [id], onDelete: Cascade)

  @@map("public_pages")
  @@schema("data")
}

model public_domains {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_site_id String       @db.Uuid
  tenant_id      String       @db.Uuid
  domain         String
  status         String       @default("pending")
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  public_sites   public_sites @relation(fields: [public_site_id], references: [id], onDelete: Cascade)

  @@map("public_domains")
  @@schema("data")
}

model public_leads {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_site_id String       @db.Uuid
  tenant_id      String       @db.Uuid
  status         String       @default("new")
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  public_sites   public_sites @relation(fields: [public_site_id], references: [id], onDelete: Cascade)

  @@map("public_leads")
  @@schema("data")
}

