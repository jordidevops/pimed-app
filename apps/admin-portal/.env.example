# =============================================================================
# Variables de entorno — admin-portal
# =============================================================================
# Entorno DEV  → copia a .env.development  (commiteable, solo localhost)
# Entorno STAGING → copia a .env.staging   (gitignored, valores reales)
# Entorno PROD    → copia a .env.production (gitignored, valores reales)
#
# Obtener la publishable key en dev: supabase status
# Obtener en staging/prod: Supabase Dashboard > Settings > API
# =============================================================================

# URL del proyecto Supabase
# dev:     http://localhost:54321
# staging: https://<staging-ref>.supabase.co
# prod:    https://<prod-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Clave anon pública (segura para el cliente)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key-here

# URL del tenant-portal — usada como redirectTo en los correos de invitación
# dev:     http://localhost:5173
# staging: https://app-staging.example.com
# prod:    https://app.example.com
TENANT_PORTAL_URL=http://localhost:5173

# Clave secreta service_role — SOLO server-side (Server Actions / Route Handlers)
# Permite leer storage.buckets y operar como admin
# NUNCA exponer en el cliente
#
# ⚠️  DIFERÈNCIA DE FORMAT respecte les Edge Functions:
#   admin-portal (Node.js/Next.js) usa el format nou:  sb_secret_XXXX
#     → obtenir amb `supabase status` (línia "Authentication Keys - Secret")
#
#   Edge Functions (Deno) necessiten el format JWT:  eyJ...
#     → obtenir amb `supabase status --output env` (SUPABASE_SERVICE_ROLE_KEY)
#     → veure supabase/functions/.env.local per més detalls
#
# En staging/prod: copiar el valor del Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend API key — per cridar l'API de Resend des de Server Actions (GET /emails/{id}, etc.)
# IMPORTANT: ha de ser una clau amb permís "Full access" (no "Sending access only")
# Crear a: https://resend.com/api-keys → New API Key → Permission: Full access
# ⚠️  Diferent de la clau a supabase/functions/.env (que s'usa per enviar)
RESEND_API_KEY=re_your_full_access_key_here

# Prisma — conexión directa al PostgreSQL del stack local de Supabase (puerto 54322)
# Para staging/prod, sobrescribir en .env.staging / .env.production con las URLs reales.
# Prisma v7 usa una única URL (no hay directUrl). Usar siempre conexión directa (sin pgbouncer).
# dev:     postgresql://prisma_admin:prisma_local_dev@localhost:54322/postgres?schema=data
# staging: postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# prod:    postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://prisma_admin:prisma_local_dev@localhost:54322/postgres?schema=data"

# Direct connection — usada por `prisma db pull`
# dev:     postgresql://postgres:postgres@localhost:54322/postgres
# staging: postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# prod:    postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# Prisma v7 usa una única URL (no hay directUrl). Usar siempre conexión directa (sin pgbouncer).
# DIRECT_URL=<no es necessari>

# Observabilitat — Sentry (staging/prod; buit en local)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENVIRONMENT=local