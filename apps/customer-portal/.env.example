# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key-here

# Server-only gateway key + limited BFF capability. The BFF must never receive SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
CUSTOMER_PORTAL_BFF_SECRET=replace-with-at-least-32-random-bytes
# Bash: openssl rand -hex 32
# PS: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Same secret at supabase/functions/.env.local

# Canonical origin (tenant-portal VITE_CUSTOMER_PORTAL_ORIGIN should match)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3003

# Optional: Art. 13 privacy info link shown in reader footer
# NEXT_PUBLIC_PRIVACY_INFO_URL=https://example.com/privacy

# Host pattern for future subdomain routing: {tenant}.customer.{domain}
# NEXT_PUBLIC_CUSTOMER_SYSTEM_DOMAIN=customer.example.dev
