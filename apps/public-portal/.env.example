# Supabase (obligatori)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key-here

# URL canònica del portal (enllaços verify/preferències als emails).
# No confiar en Origin del client. Ex.: https://public.example.dev
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3002
# Alternativa (si no uses NEXT_PUBLIC_SITE_URL):
# PUBLIC_PORTAL_BASE_URL=http://127.0.0.1:3002

# Domini del sistema (per al middleware de custom domains)
# Qualsevol host que NO contingui aquest valor es tractarà com a custom domain
NEXT_PUBLIC_PORTAL_SYSTEM_DOMAIN=public.example.dev

# Sufixos addicionals considerats "dominis del sistema" (separats per comes)
# Exemples: .public.example.dev,.internal.example.dev
NEXT_PUBLIC_PORTAL_SYSTEM_SUFFIXES=

# Branding global del portal públic
NEXT_PUBLIC_APP_DISPLAY_NAME=Your App

# DNS per a custom domains (ha de quadrar amb les comprovacions del backend)
NEXT_PUBLIC_PORTAL_DNS_CNAME_TARGET=proxy.public.example.com
NEXT_PUBLIC_PORTAL_DNS_TXT_PREFIX=_portal-verify

# ISR revalidate després de publicar contingut (TCMS-3; mateix valor que VITE_PORTAL_REVALIDATE_SECRET al tenant-portal)
# REVALIDATE_PORTAL_SECRET=dev-revalidate-secret

# Cloudflare Turnstile — antiabús al formulari de leads
# Claus de test de Cloudflare (sempre passen, per a dev local):
#   Site key:   1x00000000000000000000AA
#   Secret key: 1x0000000000000000000000000000000AA
# Claus reals: https://dash.cloudflare.com/ → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Rate limit distribuït (opcional però recomanat en producció multi-instància)
# Si aquestes dues variables existeixen, el formulari usarà Upstash Redis per aplicar
# el límit global entre totes les instàncies.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Turnstile en producció és fail-closed per defecte.
# Només activar en incidència externa temporal (risc de bypass anti-bot).
TURNSTILE_FAIL_OPEN=false

# Employee Portal (EP0+) — proxy server-to-server cap a employee-portal-api
# Service role (format JWT eyJ... en local: supabase status --output env)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Opcional si l'API no segueix el patró estàndard /functions/v1/employee-portal-api
# EMPLOYEE_PORTAL_API_URL=http://127.0.0.1:54321/functions/v1/employee-portal-api
