# Credenciales para Google OAuth en entorno local.
# Supabase CLI lee este archivo automáticamente al ejecutar `supabase start`.
# NUNCA subir a git — está en .gitignore.
#
# Cómo obtener estos valores:
#   https://console.cloud.google.com > APIs & Services > Credentials
#   Authorized redirect URI: http://localhost:54321/auth/v1/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
