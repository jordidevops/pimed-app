# =============================================================================
# supabase/functions/.env.local  —  NOMÉS PER A ENTORN LOCAL
# supabase functions serve --env-file supabase/functions/.env.local
# =============================================================================
# Aquest fitxer és llegit per `supabase functions serve` en local.
# NO crear .env.staging ni .env.production: en staging/prod les variables
# s'han de guardar als Secrets del projecte Supabase (Vault):
#   Dashboard → Project Settings → Edge Functions → Secrets
#   o via CLI: supabase secrets set NOM_VARIABLE=valor --project-ref <ref>
# =============================================================================

# --- [LOCAL ONLY] Variables que NOMÉS existeixen en local dev ----------------

# URL pública de Supabase perquè les URLs signades siguin accessibles pel browser.
# En local, SUPABASE_URL dins les funcions apunta a http://kong:8000 (intern Docker).
# En staging/prod NO cal: SUPABASE_URL ja és l'URL pública real.
EXT_SUPABASE_URL=http://localhost:54321

# URL del tenant-portal (enllaços de firma nativa remota: /sign/:token)
TENANT_PORTAL_URL=http://localhost:5173

# Origin públic del customer-portal (links de share / login return-visit als emails).
# Ha de coincidir amb VITE_CUSTOMER_PORTAL_ORIGIN (tenant-portal) i
# NEXT_PUBLIC_SITE_URL (customer-portal). Port local del portal: 3003.
# En staging/prod: supabase secrets set CUSTOMER_PORTAL_ORIGIN=https://customer.example.com --project-ref <ref>
CUSTOMER_PORTAL_ORIGIN=http://localhost:3003

# Credential limitada BFF customer-portal → Edge. Ha de coincidir amb el secret
# server-only del BFF i ser independent de service_role. Per rotar sense tall:
# 1) posar l'actual a *_PREVIOUS i desplegar el nou primari a Edge;
# 2) actualitzar el BFF al nou primari;
# 3) eliminar *_PREVIOUS després del TTL màxim de requests en vol.
CUSTOMER_PORTAL_BFF_SECRET=replace-with-at-least-32-random-bytes
CUSTOMER_PORTAL_BFF_SECRET_PREVIOUS=

# Gotenberg — des de Edge Functions en local cal host.docker.internal (no localhost).
GOTENBERG_URL=http://host.docker.internal:3007

# Service Role Key local — FORMAT JWT (eyJ...), NO el format sb_secret_...
#
# ⚠️  DIFERÈNCIA IMPORTANT DE FORMAT:
#   admin-portal (.env.development) usa el format nou:  sb_secret_XXXX
#     → funciona amb supabase-js al servidor Node.js
#
#   Edge Functions (aquest fitxer) necessiten el format JWT:  eyJ...
#     → el runtime Deno espera el JWT clàssic per fer les crides internes
#     → el format sb_secret_... NO funciona aquí
#
# Com obtenir el valor correcte (format JWT):
#   supabase status --output env   → busca SUPABASE_SERVICE_ROLE_KEY=eyJ...
#   (NO usar `supabase status` a seques, que mostra el format sb_secret_...)
#
# En staging/prod NO cal definir-la: la plataforma Supabase injecta
# SUPABASE_SERVICE_ROLE_KEY automàticament a totes les Edge Functions.
SERVICE_ROLE_KEY=eyJ...

# --- [VAULT] Variables necessàries en TOTS els entorns -----------------------
# En local: defineix-les aquí.
# En staging/prod: afegeix-les als Secrets del Vault (NO posar-les en cap fitxer).
#   supabase secrets set RESEND_API_KEY=re_xxx --project-ref <ref>

# Api key del servei d'enviament de correus. MAI exposar al client.
RESEND_API_KEY=

# Secret per validar les peticions del webhook de Resend. MAI exposar al client.
# Veure docs: supabase/tests/functions.md
RESEND_WEBHOOK_SECRET=

# Redis per a cues de correu (opcional en local, recomanat en producció)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Prefix del registre TXT de verificació de dominis públics.
# Ha de coincidir amb VITE_PORTAL_DNS_TXT_PREFIX al tenant-portal.
PORTAL_DNS_TXT_PREFIX=_portal-verify

# =============================================================================
# DocuSeal — Document Signing System (Fase 2)
# =============================================================================

# Clau API de DocuSeal per al mode platform (compartida per tots els tenants platform).
# En staging/prod: afegir als Secrets del Vault.
#   supabase secrets set DOCUSEAL_API_KEY=xxx --project-ref <ref>
DOCUSEAL_API_KEY=

# URL base de l'API DocuSeal. Per defecte apunta a la instància cloud.
# En local/staging amb instància self-hosted: canviar per la URL correcta.
DOCUSEAL_API_URL=https://api.docuseal.eu

# Secret per validar la signatura HMAC-SHA256 dels webhooks de DocuSeal.
# Configurar a DocuSeal Dashboard → Webhooks → Secret.
# En staging/prod: afegir als Secrets del Vault.
DOCUSEAL_WEBHOOK_SECRET=

# =============================================================================
# Observabilitat — Sentry (staging/prod només; local usa console adapter)
# =============================================================================
# Veure docs/runbooks/fase-0-manual-setup.md
#   supabase secrets set SENTRY_DSN=https://...@....ingest.sentry.io/... --project-ref <ref>
#   supabase secrets set ENVIRONMENT=staging|production --project-ref <ref>
SENTRY_DSN=
ENVIRONMENT=local

# =============================================================================
# Employee Portal (EP0+) — sessió JWT via proxy public-portal
# =============================================================================
# Secret HS256 per signar JWT de sessió del portal empleat (15 min).
# En staging/prod: supabase secrets set EMPLOYEE_PORTAL_JWT_SECRET=... --project-ref <ref>
EMPLOYEE_PORTAL_JWT_SECRET=change-me-local-dev-only
# Opcional: durada sessió en minuts (per defecte 15)
# EMPLOYEE_PORTAL_SESSION_MINUTES=15
# Opcional: tokens dev addicionals (JSON array) per al spike EP0
# EMPLOYEE_PORTAL_DEV_TOKENS=[{"secret":"...","token_id":"...","tenant_id":"...","employee_id":"...","full_name":"..."}]

# Signatura HMAC per tokens de propostes d'escriptura IA (xat).
# En local pot coincidir amb SERVICE_ROLE_KEY si no es defineix.
AI_PROPOSAL_SECRET=

# =============================================================================
# Maps JS — platform trial key (Fase B fallback)
# =============================================================================
# Preferible: desar al Vault DB amb nom maps_js_platform_trial_api_key
# (admin → Settings → Maps JS platform entitlements → "Desa al Vault").
# Aquest env és un fallback temporal per edge get-maps-js-browser-key.
# En staging/prod: supabase secrets set MAPS_JS_PLATFORM_TRIAL_API_KEY=... --project-ref <ref>
MAPS_JS_PLATFORM_TRIAL_API_KEY=

# Map ID del mateix projecte GCP que la clau trial (no secret).
# Preferible: admin → Maps JS platform entitlements → "Desa Map ID"
# (data.system_settings module maps_js). Fallback env:
MAPS_JS_PLATFORM_MAP_ID=